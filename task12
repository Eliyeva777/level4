#include <iostream>
using namespace std;
int main() {
    int n;
    int bolenler_cemi = 0;
    cout << "ədəd daxil edin: ";
    cin >> n;
    if (n <= 1) {
        cout << n << " mükəmməl ədəd deyil." << endl;
        return 0;
  }
    for (int i = 1; i < n; ++i) {
        if (n % i == 0) {
            bolenler_cemi += i;
        }
    }

    if (bolenler_cemi == n) {
        cout << n << " ədədi MÜKƏMMƏL ƏDƏDDİR." << endl; 
    } else {
        cout << n << " ədədi MÜKƏMMƏL ƏDƏD DEYİL." << endl;
    }
    return 0;
}
