#include <iostream>
using namespace std;
int main() {
    int t1 = 0, t2 = 1, next_term = 0;
    cout << "1000-dən kiçik Fibonacci ədədləri: ";
    cout << t1 << " ";
    if (t2 < 1000) {
        cout << t2 << " ";
    }
    while (true) {
        next_term = t1 + t2;
        
        if (next_term >= 1000) {
            break; 
        }
        cout << next_term << " ";
        t1 = t2;
        t2 = next_term;
    }
    cout << endl;
    return 0;
}
