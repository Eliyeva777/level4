#include <iostream>
#include <cmath>
using namespace std;
bool is_sade(int n) {
    if (n <= 1) return false;
    for (int i = 2; i * i <= n; ++i) { 
        if (n % i == 0) return false;
    }
    return true;
}
int main() {
    int n;
    cout << "Daxil edin: ";
    cin >> n;
    cout << "N-dən kiçik sadə ədədlər: ";
    for (int i = 2; i < n; ++i) {
        if (is_sade(i)) {
            cout << i << " ";
        }
    }
    cout << endl;
    return 0;
}
