#include <iostream>
using namespace std;
int main() {
    const int SIZE = 5;
    int massiv[SIZE]; 
    int cut_indeks_cem = 0; 
    int tek_indeks_cem = 0; 
    cout << SIZE << " tam ədəd daxil edin:" << endl;
    for (int i = 0; i < SIZE; ++i) {
        cout << i << ". indeks üçün ədəd: ";
        cin >> massiv[i];
        if (i % 2 == 0) { // 0, 2, 4, ...
            cut_indeks_cem += massiv[i];
        } 
        else { // 1, 3, 5, ...
            tek_indeks_cem += massiv[i];
        }
    }
    cout << "\nCüt indeksdəki ədədlərin cəmi (0, 2, 4...): " << cut_indeks_cem << endl;
    cout << "Tək indeksdəki ədədlərin cəmi (1, 3, 5...): " << tek_indeks_cem << endl;
    return 0;
}
